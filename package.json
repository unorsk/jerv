{
  "name": "jerv",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "font": "uv run --with 'fonttools[woff]' tools/build-font.py",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unorsk/jerv.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/unorsk/jerv/issues"
  },
  "homepage": "https://github.com/unorsk/jerv#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "svelte": "^5.56.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "private": true
}
